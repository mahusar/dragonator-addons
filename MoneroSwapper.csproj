<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MoneroSwapper</AssemblyName>
    <RootNamespace>Dragonator.Swapper</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Product>MoneroSwapper</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DragonatorApi)' == ''">
    <DragonatorApi>..\StealthDragons\Library\ScriptAssemblies\Dragonator.Api.dll</DragonatorApi>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dragonator.Api">
      <HintPath>$(DragonatorApi)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckDragonatorApi" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(DragonatorApi)')"
           Text="Dragonator.Api.dll not found at '$(DragonatorApi)'. Take it from a Dragonator build (Dragonator_Data/Managed/) or a Unity checkout (Library/ScriptAssemblies/), then pass -p:DragonatorApi=&lt;path&gt;." />
  </Target>

</Project>
