<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Witness</AssemblyName>
    <RootNamespace>Dragonator.Addons</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Product>Witness</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DragonatorApi)' == ''">
    <DragonatorApi>..\..\StealthDragons\Library\ScriptAssemblies\Dragonator.Api.dll</DragonatorApi>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DragonatorApi" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dragonator.Api">
      <HintPath>$(DragonatorApi)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
